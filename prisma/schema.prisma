generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Team {
  id          Int        @id @default(autoincrement())
  name        String
  color       String     @default("#c9a84c")
  order       Int
  executiveId Int?
  executive   Executive? @relation(fields: [executiveId], references: [id], onDelete: SetNull)
  members     Member[]
}

model Member {
  id                    Int                @id @default(autoincrement())
  name                  String
  role                  String
  email                 String?
  phone                 String?
  photo                 String?
  teamId                Int
  team                  Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  isVacancy             Boolean            @default(false)
  isTeamLead            Boolean            @default(false)
  order                 Int
  subGroup              String?
  clientTeamMemberships ClientTeamMember[]
}

model Executive {
  id                    Int                @id @default(autoincrement())
  name                  String
  role                  String
  photo                 String?
  email                 String?
  phone                 String?
  level                 Int
  teams                 Team[]
  clientTeams           ClientTeam[]
  clientTeamMemberships ClientTeamMember[]
}

model ClientTeam {
  id          Int                @id @default(autoincrement())
  name        String
  order       Int
  executiveId Int?
  executive   Executive?         @relation(fields: [executiveId], references: [id], onDelete: SetNull)
  members     ClientTeamMember[]
  clients     Client[]
}

model ClientTeamMember {
  id           Int        @id @default(autoincrement())
  clientTeamId Int
  clientTeam   ClientTeam @relation(fields: [clientTeamId], references: [id], onDelete: Cascade)
  memberId     Int?
  member       Member?    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  executiveId  Int?
  executive    Executive? @relation(fields: [executiveId], references: [id], onDelete: Cascade)
  role         String
  order        Int

  @@unique([clientTeamId, memberId])
  @@unique([clientTeamId, executiveId])
}

model Client {
  id           Int        @id @default(autoincrement())
  name         String
  url          String?
  clientTeamId Int
  clientTeam   ClientTeam @relation(fields: [clientTeamId], references: [id], onDelete: Cascade)
  order        Int
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  action      String
  entity      String
  entityId    Int
  changes     String
  performedBy String   @default("admin")
  createdAt   DateTime @default(now())
}

model Admin {
  id           Int    @id @default(autoincrement())
  username     String @unique
  passwordHash String
}

model Setting {
  key   String @id
  value String
}
