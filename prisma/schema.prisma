generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Team {
  id          Int        @id @default(autoincrement())
  name        String
  color       String     @default("#c9a84c")
  order       Int
  executiveId Int?
  executive   Executive? @relation(fields: [executiveId], references: [id], onDelete: SetNull)
  members     Member[]
}

model Member {
  id                    Int                @id @default(autoincrement())
  name                  String
  role                  String
  email                 String?
  phone                 String?
  photo                 String?
  teamId                Int?
  team                  Team?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  isVacancy             Boolean            @default(false)
  isTeamLead            Boolean            @default(false)
  order                 Int
  subGroup              String?
  clientTeamMemberships ClientTeamMember[]
}

model Executive {
  id                    Int                @id @default(autoincrement())
  name                  String
  role                  String
  photo                 String?
  email                 String?
  phone                 String?
  level                 Int
  teams                 Team[]
  clientTeams           ClientTeam[]
  clientTeamMemberships ClientTeamMember[]
}

model ClientTeam {
  id          Int                @id @default(autoincrement())
  name        String
  order       Int
  executiveId Int?
  executive   Executive?         @relation(fields: [executiveId], references: [id], onDelete: SetNull)
  members     ClientTeamMember[]
  clients     Client[]
}

model ClientTeamMember {
  id           Int        @id @default(autoincrement())
  clientTeamId Int
  clientTeam   ClientTeam @relation(fields: [clientTeamId], references: [id], onDelete: Cascade)
  memberId     Int?
  member       Member?    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  executiveId  Int?
  executive    Executive? @relation(fields: [executiveId], references: [id], onDelete: Cascade)
  role         String
  order        Int

  @@unique([clientTeamId, memberId])
  @@unique([clientTeamId, executiveId])
}

model Client {
  id           Int        @id @default(autoincrement())
  name         String
  url          String?
  clientTeamId Int
  clientTeam   ClientTeam @relation(fields: [clientTeamId], references: [id], onDelete: Cascade)
  order        Int
}

model Supercharger {
  id               Int                            @id @default(autoincrement())
  firstName        String
  lastName         String
  function         String                         @default("Supercharger")
  email            String?
  phone            String?
  birthDate        DateTime?
  photo            String?
  activations      ActivationStaff[]
  projectLocations ProjectLocationSupercharger[]
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  action      String
  entity      String
  entityId    Int
  changes     String
  performedBy String   @default("admin")
  createdAt   DateTime @default(now())
}

model User {
  id            Int                  @id @default(autoincrement())
  username      String               @unique
  email         String?
  passwordHash  String
  role          String               @default("user")
  allowedTabs   String               @default("[]")
  resetTokens   PasswordResetToken[]
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Setting {
  key   String @id
  value String
}

model Klant {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  contactPerson String?
  email         String?
  logo          String?
  adres         String?
  postcode      String?
  stad          String?
  land          String?
  contacts      KlantContact[]
  projects      Project[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Toeleverancier {
  id            Int                         @id @default(autoincrement())
  name          String                      @unique
  contactPerson String?
  email         String?
  logo          String?
  adres         String?
  postcode      String?
  stad          String?
  land          String?
  contacts      ToeleverancierContact[]
  specialismes  ToeleverancierSpecialisme[]
  projects      ProjectToeleverancier[]
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
}

model Specialisme {
  id              Int                         @id @default(autoincrement())
  naam            String                      @unique
  toeleveranciers ToeleverancierSpecialisme[]
}

model ToeleverancierSpecialisme {
  toeleverancierId Int
  specialismeId    Int
  toeleverancier   Toeleverancier @relation(fields: [toeleverancierId], references: [id], onDelete: Cascade)
  specialisme      Specialisme    @relation(fields: [specialismeId], references: [id], onDelete: Cascade)

  @@id([toeleverancierId, specialismeId])
}

model ToeleverancierContact {
  id               Int            @id @default(autoincrement())
  toeleverancierId Int
  toeleverancier   Toeleverancier @relation(fields: [toeleverancierId], references: [id], onDelete: Cascade)
  naam             String
  email            String?
  telefoon         String?
  order            Int            @default(0)

  @@index([toeleverancierId])
}

model KlantContact {
  id       Int    @id @default(autoincrement())
  klantId  Int
  klant    Klant  @relation(fields: [klantId], references: [id], onDelete: Cascade)
  naam     String
  email    String?
  telefoon String?
  order    Int    @default(0)

  @@index([klantId])
}

model Project {
  id                     Int          @id @default(autoincrement())
  klantId                Int
  klant                  Klant        @relation(fields: [klantId], references: [id], onDelete: Restrict)
  projectNumber          String       @unique
  name                   String?
  startDate              DateTime
  endDate                DateTime
  status                 String       @default("active")
  contactPerson          String?
  email                  String?
  needsLocations         Boolean      @default(false)
  needsSuperchargers     Boolean      @default(false)
  notities               String       @default("")
  // Deelbare locatie-link voor klant (alleen-lezen locatie-overzicht)
  locationShareToken     String?      @unique
  locationSharePassword  String?
  // Campagne-brede briefing velden
  campaignDescription    String?
  campaignMessage        String?
  campaignTargetAudience String?
  campaignTarget         String?
  clothing               String?
  settingInstructions    String?
  extraInfo              String?
  activations            Activation[]
  locations              ProjectLocation[]
  contacts               ProjectContact[]
  toeleveranciers        ProjectToeleverancier[]
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([klantId])
}

model ProjectToeleverancier {
  projectId        Int
  toeleverancierId Int
  telefoon         String?
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  toeleverancier   Toeleverancier @relation(fields: [toeleverancierId], references: [id], onDelete: Cascade)

  @@id([projectId, toeleverancierId])
  @@index([projectId])
  @@index([toeleverancierId])
}

model ProjectLocation {
  id            Int                            @id @default(autoincrement())
  projectId     Int
  project       Project                        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  locationId    Int
  location      Location                       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  order         Int                            @default(0)
  startDate     DateTime?
  endDate       DateTime?
  available     String                         @default("unknown")
  actionOpen    Boolean                        @default(false)
  actionLabel   String?
  opmerkingen   String                         @default("")
  superchargers ProjectLocationSupercharger[]

  @@index([projectId])
  @@index([locationId])
}

model ProjectLocationSupercharger {
  id                Int             @id @default(autoincrement())
  projectLocationId Int
  projectLocation   ProjectLocation @relation(fields: [projectLocationId], references: [id], onDelete: Cascade)
  superchargerId    Int
  supercharger      Supercharger    @relation(fields: [superchargerId], references: [id], onDelete: Cascade)
  // Availability per dag: JSON { "2026-06-05": true, "2026-06-06": false, ... }
  availability      String          @default("{}")
  order             Int             @default(0)

  @@unique([projectLocationId, superchargerId])
  @@index([projectLocationId])
  @@index([superchargerId])
}

model ProjectContact {
  id        Int     @id @default(autoincrement())
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  naam      String
  email     String?
  telefoon  String?
  order     Int     @default(0)

  @@index([projectId])
}

model Activation {
  id                Int               @id @default(autoincrement())
  projectId         Int
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  location          String            @default("")
  locationLat       Float?
  locationLon       Float?
  locationZoom      Int?
  date              DateTime?
  briefingToken     String?           @unique
  startTime         String?
  endTime           String?
  scheduleItems     String            @default("[]")
  tasks             String?
  storeList         String?
  photoRequirements String?
  extraInfo         String?
  evaluationLink    String?
  target            String?
  staff             ActivationStaff[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([projectId])
}

model ActivationStaff {
  id             Int          @id @default(autoincrement())
  activationId   Int
  activation     Activation   @relation(fields: [activationId], references: [id], onDelete: Cascade)
  superchargerId Int
  supercharger   Supercharger @relation(fields: [superchargerId], references: [id], onDelete: Cascade)
  role           String       @default("supercharger")

  @@unique([activationId, superchargerId])
  @@index([activationId])
  @@index([superchargerId])
}

model Location {
  id                Int      @id @default(autoincrement())
  code              String?  @unique
  naam              String
  land              String
  stad              String?
  adres             String
  lat               Float?
  lng               Float?
  omgevingType      String   @default("centrum")
  orientatie        String   @default("N")
  eigendomType      String   @default("particulier")
  vergunningNodig   Boolean  @default(false)
  vergunningLink    String?
  truckBereikbaar   Boolean  @default(false)
  geschiktActivatie Boolean  @default(false)
  geschiktSampling  Boolean  @default(false)
  geschiktHotspot   Boolean  @default(false)
  geschiktAnder     String?
  stroom            Boolean  @default(false)
  verlichting       Boolean  @default(false)
  lengte            Float?
  breedte           Float?
  m2                Float?
  notities          String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  contacts     LocationContact[]
  photos       LocationPhoto[]
  costs        LocationCost[]
  projects     ProjectLocation[]
}

model LocationContact {
  id         Int      @id @default(autoincrement())
  locationId Int
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  naam       String
  email      String?
  telefoon   String?
  website    String?
  rol        String?
  order      Int

  @@index([locationId])
}

model LocationPhoto {
  id         Int      @id @default(autoincrement())
  locationId Int
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  filename   String
  isMain     Boolean  @default(false)
  order      Int
  createdAt  DateTime @default(now())

  @@index([locationId])
}

model LocationCost {
  id          Int      @id @default(autoincrement())
  locationId  Int
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  label       String   @default("Locatiehuur")
  bedragCents Int      @default(0)
  order       Int

  @@index([locationId])
}
